{
  "name": "meetingos-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
 
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:agents": "pnpm --filter api exec vitest run src/graph",
    "seed": "pnpm --filter api exec tsx src/scripts/seed.ts",
    "eval:live": "pnpm --filter api exec tsx src/scripts/eval-live.ts",
    "verify:scaffold": "powershell -ExecutionPolicy Bypass -File scripts/verify-scaffold.ps1",
    "check:no-secrets": "powershell -ExecutionPolicy Bypass -File scripts/check-no-secrets.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
